#include <windows.h>
#include "version.h"

101 ICON "assets\\driver-scanner.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION DRIVER_SCANNER_VERSION_TUPLE
 PRODUCTVERSION DRIVER_SCANNER_VERSION_TUPLE
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Driver Scanner"
            VALUE "FileVersion", DRIVER_SCANNER_VERSION_STRING
            VALUE "InternalName", "DriverScanner"
            VALUE "LegalCopyright", "Created by Mavix"
            VALUE "OriginalFilename", "Driver Scanner.exe"
            VALUE "ProductName", "Driver Scanner"
            VALUE "ProductVersion", DRIVER_SCANNER_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
